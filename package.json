{
  "name": "smart-personal-checklist-api",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:cleanup": "tsx src/test-e2e/cleanup.ts",
    "test:admins": "tsx src/test-e2e/seed-admins.ts",
    "check": "npm run typecheck && npm run lint && npm run dup:check && npm run format:check && npm test && npm run build",
    "db:migrate": "npm run build && sequelize-cli db:migrate",
    "db:migrate:undo": "npm run build && sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "npm run build && sequelize-cli db:migrate:undo:all",
    "db:seed": "npm run build && sequelize-cli db:seed:all",
    "db:seed:undo": "npm run build && sequelize-cli db:seed:undo:all",
    "dup:check": "jscpd"
  },
  "license": "ISC",
  "description": "Backend skeleton (Express + Sequelize + PostgreSQL)",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.5.1",
    "eslint": "^9.39.5",
    "jscpd": "^4.3.0",
    "prettier": "^3.9.10",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
