# Copy to .env and fill in. Real environment variables override this file.

# Shown in logs and GET /api/health.
APP_NAME=smart-personal-checklist-api
# Shown on the admin dashboard; defaults to package.json's version when started with npm.
# APP_VERSION=1.0.0
NODE_ENV=development

PORT=3001
API_PREFIX=/api
# The web app's address; several separated by commas, e.g. adding the browser-test build:
# CORS_ORIGIN=http://localhost:3000,http://localhost:3100
CORS_ORIGIN=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=app
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=admin
# Print every SQL query (true/false).
DATABASE_LOGGING=false

# Required. The app will not start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime (e.g. 15m, 1h). Clients renew it with the refresh token.
JWT_EXPIRES_IN=15m
# Days a refresh token stays valid. Each use replaces it with a fresh one.
REFRESH_TOKEN_DAYS=30

# Where uploaded files (transaction attachments) are stored on disk.
UPLOAD_DIR=storage/uploads

# Settings a new user starts with (each user can change their own).
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_TIME_ZONE=Asia/Kolkata
# 0 = Sunday, 1 = Monday, … 6 = Saturday.
DEFAULT_WEEK_STARTS_ON=1

# Let app users create their own account (POST /api/auth/user/register).
AUTH_ALLOW_REGISTRATION=true

# Attempts allowed per 15 minutes before "429 Too Many Requests" (0 = no limit):
# failed sign-ins per account and caller, sign-in per caller (IP), and registration per IP.
# The two per-IP limits default to 100 and 20 in production and to off elsewhere,
# because locally every request comes from 127.0.0.1.
AUTH_SIGN_IN_LIMIT=10
# AUTH_SIGN_IN_IP_LIMIT=100
# AUTH_REGISTER_LIMIT=20

# Used once by `npm run db:seed` to create the first admin (login method
# "password"). Remove the password after seeding.
ADMIN_SEED_USER_NAME=admin
ADMIN_SEED_PASSWORD=
